20 REM
30 REM   FPDEMO.BAS
40 REM   by Bruce E. Hall, 26 Aug 2026
50 REM
60 REM   Animate the front panel LEDs
70 REM   according to switch input.  
80 REM
90 PRINT
100 PRINT" FRONT PANEL LED DEMO"
110 PRINT" Use switches 2 through 0 to choose an animation."
120 PRINT
130 PRINT" 000 - Stop"
135 PRINT" 001 - Reset Counter"
140 PRINT" 010 - Count up"
145 PRINT" 011 - Count down"
150 PRINT" 100 - Blinkenlights"
155 PRINT" 101 - Alternating bits" 
160 PRINT" 110 - Cylon1"
170 PRINT" 111 - Cylon2"
180 PRINT
300 A=INP(P) AND 7: 'consider only last 3 switches
310 ON A GOSUB 330,450,520,590,650,710,710
320 GOTO 300
330 REM
340 REM  SUBROUTINE: CLEAR BITS
350 REM 
360 I=0
370 GOSUB 390
380 RETURN
390 REM
400 REM  SUBROUTINE: SHOW IT
410 REM
420 OUT 0,I
430 FOR J=1 TO 200: NEXT J
440 RETURN
450 REM
460 REM  SUBROUTINE: COUNT UP
470 REM
480 I=I+1
490 IF I>255 THEN I=0
500 GOSUB 390
510 RETURN
520 REM
530 REM  SUBROUTINE: COUNT DOWN
540 REM
550 I=I-1
560 IF I<0 THEN I=255
570 GOSUB 390
580 RETURN
590 REM
600 REM  SUBROUTINE: RANDOM NUMBERS
610 REM
620 I=INT(RND*256)
630 GOSUB 390
640 RETURN
650 REM
660 REM  SUBROUTINE: ALTERNATING BITS
670 REM
680 IF I=&H55 THEN I=&HAA ELSE I=&H55
690 GOSUB 390
700 RETURN
710 REM
720 REM  SUBROUTINE: LAWSON SCANNER
730 REM
740 BIT=1
750 FOR I=1 TO 8
760 OUT 0,BIT
770 BIT=BIT*2
780 IF A=7 THEN BIT=BIT+1
790 FOR J=1 TO 100: NEXT J
800 NEXT I
810 BIT=BIT\2
820 FOR I=1 TO 6
830 BIT=BIT\2
840 OUT 0,BIT
850 FOR J=1 TO 100: NEXT J
860 NEXT I
870 RETURN