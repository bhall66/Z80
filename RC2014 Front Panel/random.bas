20 REM
30 REM   RANDOM.BAS
40 REM   by Bruce E. Hall, 25 Aug 2026
50 REM
60 REM   Display random characters at
70 REM   random positions on the LCD.
80 REM
85 OUT 218,1
90 R[0]=0:R[1]=64:R[2]=20:R[3]=84
100 RANDOMIZE 42
110 ROW=INT(RND*4)
120 COL=INT(RND*20)
130 CHAR=INT(RND*128)
131 IF CHAR<32 GOTO 130
140 CPOS=R[ROW]+COL
160 OUT 218,128+CPOS
170 OUT 219,CHAR
180 FOR I=1 TO 30:NEXT
190 GOTO 110