0001   0000             ;
0002   0000             ;   Title:   sinewave.asm
0003   0000             ;  Author:   Bruce E. Hall, w8bh
0004   0000             ;    Date:   28 Aug 2026
0005   0000             ;      HW:   RC2014Zed with 512K RAM/ROM module
0006   0000             ;      SW:   TASM compiler, RomWBW firmware
0007   0000             ;
0008   0000             ;  Show animated vertical bar graph in the shape of a sine wave
0009   0000             ;  on the front panel LCD module
0010   0000             ;
0011   0000             
0012   0000             cmdPort	      .equ	  $DA	 ; port for SIO Channel A cmd/status
0013   0000             dataPort	  .equ	  $DB	 ; port for SIO Channel A data  
0014   0000             
0015   0000             ; HD44780 Controller Commands 
0016   0000             ;
0017   0000             CLEAR_DISPLAY .equ    $01    ; clear screen command
0018   0000             LOAD_SYMBOL   .equ    $40    ; set CG-RAM address
0019   0000             SET_CURSOR    .equ    $80    ; set display RAM address
0020   0000             
0021   0000             ; program constants
0022   0000             ;
0023   0000             LMARGIN       .equ 5         ; starting column for vertical bars
0024   0000             NUMBARS       .equ 15        ; number of vertical bars to show
0025   0000             SPEED         .equ 12        ; animation speed (in mS)
0026   0000             
0027   0100             .ORG $0100
0028   0100             
0029   0100             Start:
0030   0100 CD 47 01        CALL LoadIcons           ; load vbar icons
0031   0103 CD AD 01        CALL ClearScreen
0032   0106 16 00           LD   D,0                 ; D is the phase counter
0033   0108             L03:
0034   0108 1E 00           LD   E,0                 ; first bar (E is bar counter)
0035   010A             L02:
0036   010A 7B              LD   A,E                 ; get column
0037   010B 82              ADD  A,D                 ; add in phase offset
0038   010C 06 0F           LD   B,15                ; use modulo fn to
0039   010E CD 3E 01        CALL IntDiv              ; force range 0-14
0040   0111 CD 33 01        CALL GetSine             ; A = 15*sin(A*24)+16
0041   0114 4F              LD   C,A                 ; save value in C
0042   0115 7B              LD   A,E 
0043   0116 C6 05           ADD  A,LMARGIN           ; left margin
0044   0118 47              LD   B,A                 ; to use as column #
0045   0119 CD 78 01        CALL EraseVBar
0046   011C CD 59 01        CALL DrawVBar            ; show the bar         
0047   011F 23              INC  HL                  ; point to value of next bar
0048   0120 1C              INC  E                   ; bump bar counter
0049   0121 3E 0F           LD   A,NUMBARS                 
0050   0123 BB              CP   E                   ; done with last bar yet? 
0051   0124 20 E4           JR   NZ,L02              ; no, go to next bar
0052   0126 14              INC  D                   ; all bars done, advance phase
0053   0127 CD 8B 01        CALL ExitOnKeypress      ; see if user wants to quit
0054   012A 01 C8 00        LD   BC,200
0055   012D CD D7 01        CALL DELAY_BC            ; animation delay
0056   0130 C3 08 01        JP   L03                 ; go back to first bar
0057   0133                                          ; and loop until keypress
0058   0133             
0059   0133             ; return A = 15*sine(A*24)+16, where A = 0 to 14
0060   0133             ; uses HL
0061   0133             GetSine:
0062   0133 D5              PUSH DE
0063   0134 16 00           LD   D,0
0064   0136 5F              LD   E,A                 ; DE = A
0065   0137 21 27 02        LD   HL,sine             ; point to LUT           
0066   013A 19              ADD  HL,DE               ; point to result
0067   013B 7E              LD   A,(HL)              ; get result in A
0068   013C D1              POP  DE
0069   013D C9              RET 
0070   013E             
0071   013E             ; INTEGER DIVISION: A/B
0072   013E             ;   return A= A mod B
0073   013E             ;   return C= A div B
0074   013E             ;
0075   013E             IntDiv:
0076   013E 0E 00           LD   C,0
0077   0140             id1:
0078   0140 0C              INC  C
0079   0141 90              SUB  B
0080   0142 30 FC           JR   NC,id1
0081   0144 0D              DEC  C 
0082   0145 80              ADD  A,B
0083   0146 C9              RET  
0084   0147             
0085   0147             LoadIcons:
0086   0147 3E 40           LD   A,LOAD_SYMBOL     
0087   0149 CD 9D 01        CALL SendCommand         ; send "set CGRAM address=0" cmd
0088   014C 21 E3 01        LD   HL,VBAR0            ; point to icons to be loaded
0089   014F 06 40           LD   B,64                ; sending 64 bytes = 8 icons
0090   0151             li0:
0091   0151 7E              LD   A,(HL)              ; get icon data byte
0092   0152 CD A5 01        Call SendChar            ; send it
0093   0155 23              INC  HL                  ; point to next byte
0094   0156 10 F9           DJNZ li0                 ; loop until all sent
0095   0158 C9              RET 
0096   0159             
0097   0159             DrawVBar:
0098   0159 3E 03           LD   A,3
0099   015B CD B3 01        CALL GotoRC              ; position @ bottom of column
0100   015E             dvb1:
0101   015E F5              PUSH AF                  ; save A=row on stack
0102   015F 79              LD   A,C                 ; look at current value
0103   0160 D6 08           SUB  8                   ; remove 8 from it
0104   0162 4F              LD   C,A                 ; save result
0105   0163 38 0C           JR   C,dvb0              ; skip if less than 8
0106   0165 3E FF           LD   A,$FF                 
0107   0167 CD A5 01        CALL SendChar            ; draw full 8 bars
0108   016A F1              POP  AF                  ; restore row
0109   016B 3D              DEC  A                   ; go up one row
0110   016C CD B3 01        CALL GotoRC              ; and set cursor there
0111   016F 18 ED           JR   dvb1
0112   0171             dvb0:                        ; get here when remainder <8
0113   0171 C6 08           ADD  A,8                 ; undo last subract
0114   0173 CD A5 01        CALL SendChar            ; print it as 1-7 bars
0115   0176 F1              POP  AF                  ; restore row
0116   0177 C9              RET
0117   0178             
0118   0178             ; call with C = column position of the vbar to erase
0119   0178             ;
0120   0178             EraseVBar:
0121   0178 C5              PUSH BC
0122   0179 3E 03           LD   A,3                  ; start on bottom row
0123   017B             ev1:
0124   017B CD B3 01        CALL GotoRC               ; position cursor
0125   017E 4F              LD   C,A                  ; save column
0126   017F 3E 20           LD   A,$20                ; erase = space char
0127   0181 CD A5 01        CALL SendChar             ; erase it
0128   0184 79              LD   A,C                  ; restore column
0129   0185 3D              DEC  A                    ; go up one row
0130   0186 F2 7B 01        JP   P,ev1                ; loop until top row done
0131   0189 C1              POP  BC 
0132   018A C9              RET 
0133   018B             
0134   018B             ExitOnKeypress:
0135   018B C5              PUSH BC
0136   018C D5              PUSH DE 
0137   018D E5              PUSH HL
0138   018E 0E 80           LD  C,$80                ; for current console.
0139   0190 06 02           LD  B,$02                ; check char input buffer
0140   0192 CF              RST 08                   ; call the HBIOS routine
0141   0193 E1              POP HL
0142   0194 D1              POP DE
0143   0195 C1              POP BC 
0144   0196 C8              RET Z                    ; nothing waiting, so return
0145   0197 CD AD 01        CALL ClearScreen
0146   019A C3 00 00        JP  0                    ; return to CP/M
0147   019D             
0148   019D             ;=============================================================
0149   019D             ;
0150   019D             ;   LCD ROUTINES
0151   019D             ;
0152   019D             
0153   019D             SendCommand:
0154   019D D3 DA           OUT (cmdPort),A          ; send the command
0155   019F DB DA           IN A,(cmdPort)           ; check LCD status (bit 7 = busy)
0156   01A1 07              RLCA                     ; move status bit to carry 
0157   01A2 38 FB           JR  C,$-3                ; wait until ready
0158   01A4 C9              RET
0159   01A5             
0160   01A5             SendChar:
0161   01A5 D3 DB           OUT (dataPort),A         ; send a character to LCD
0162   01A7 DB DA           IN A,(cmdPort)           ; check LCD status (bit 7 = busy)
0163   01A9 07              RLCA                     ; move status bit to carry 
0164   01AA 38 FB           JR  C,$-3                ; wait until ready
0165   01AC C9              RET
0166   01AD             
0167   01AD             ClearScreen:
0168   01AD 3E 01           LD   A,CLEAR_DISPLAY
0169   01AF CD 9D 01        CALL SendCommand
0170   01B2 C9              RET 
0171   01B3             
0172   01B3             
0173   01B3             ; MOVE LCD CURSOR TO A=ROW(0-3), B=COLUMN(0-19)
0174   01B3             ;
0175   01B3             GotoRC:
0176   01B3 F5              PUSH AF
0177   01B4 D5              PUSH DE 
0178   01B5 E5              PUSH HL 
0179   01B6 21 23 02        LD   HL,LINEDAT          ; point to line offset table
0180   01B9 5F              LD   E,A               
0181   01BA 16 00           LD   D,0                 ; DE = row
0182   01BC 19              ADD  HL,DE               ; point to desired line offset
0183   01BD 7E              LD   A,(HL)              ; A now = addr of line start
0184   01BE 80              ADD  A,B                 ; add in column
0185   01BF F6 80           OR   SET_CURSOR          ; add "set DDRAM address"  
0186   01C1 CD 9D 01        CALL SendCommand         ; send the command
0187   01C4 E1              POP  HL 
0188   01C5 D1              POP  DE
0189   01C6 F1              POP  AF
0190   01C7 C9              RET
0191   01C8             
0192   01C8             
0193   01C8             ; DELAY ROUTINES
0194   01C8             ;
0195   01C8             ; THESE ROUTINES ARE BASED ON A Z-80 CPU CLOCK OF 7.3728 MHz
0196   01C8             ; At that frequency, each T-state takes 0.1356 uS.
0197   01C8             ; 1 millisecond delay requires 7373 T-states.
0198   01C8             
0199   01C8             ; DELAY_INNER:
0200   01C8             ; Desired length = 7348T, slightly shorter than 1mS
0201   01C8             ; The call itself takes 17T, leaving 7331T in the routine.
0202   01C8             ; Saving/restoring registers,loading BC and returning takes 41T,
0203   01C8             ; leaving 7290T for the delay loop.  This is done with
0204   01C8             ; 303 loops of 24T, plus 18T padding at the end.
0205   01C8             ; 
0206   01C8             DELAY_INNER:
0207   01C8 C5              PUSH BC                 ; 11T
0208   01C9 01 2F 01        LD  BC,303              ; 10T
0209   01CC             J03:                        ; Loop = 24*bc = 7272T
0210   01CC 0B              DEC BC                  ; 6T
0211   01CD 78              LD  A,B                 ; 4T
0212   01CE B1              OR  C                   ; 4T
0213   01CF C2 CC 01        JP  NZ,J03              ; 10T 
0214   01D2 03              INC BC                  ; add +18T padding
0215   01D3 03              INC BC
0216   01D4 03              INC BC
0217   01D5 C1              POP BC                  ; 10T
0218   01D6 C9              RET                     ; 10T
0219   01D7             
0220   01D7             ; DELAY_BC is called with BC= desired delay in milliseconds
0221   01D7             ; when finished, BC=0.
0222   01D7             ;
0223   01D7             ; Actual Time Delay, in T-states:
0224   01D7             ; loading BC & calling DELAY_BC:  27T
0225   01D7             ; DELAY_BC itself:  7372*BC + 31T
0226   01D7             ; TOTAL = 7372*BC + 58
0227   01D7             ; For example, 1 second: 7372*1000 + 58 = 7,372,058T (999.9mS)
0228   01D7             ; 
0229   01D7             DELAY_BC:
0230   01D7 F5              PUSH AF                 ; 11T
0231   01D8             J04:                        ; bc * 7372T
0232   01D8 CD C8 01        CALL DELAY_INNER        ; 7348T
0233   01DB 0B              DEC BC                  ; 6T
0234   01DC 78              LD  A,B                 ; 4T
0235   01DD B1              OR  C                   ; 4T
0236   01DE C2 D8 01        JP  NZ,J04              ; 10T 
0237   01E1 F1              POP AF                  ; 10T
0238   01E2 C9              RET                     ; 10T 
0239   01E3             
0240   01E3             ;=============================================================
0241   01E3             ;
0242   01E3             ;   PROGRAM CONSTANTS
0243   01E3             ;
0244   01E3             
0245   01E3 00 00 00 00 VBAR0     .DB $00,$00,$00,$00,$00,$00,$00,$00
0245   01E7 00 00 00 00 
0246   01EB 00 00 00 00 VBAR1     .DB $00,$00,$00,$00,$00,$00,$00,$1F
0246   01EF 00 00 00 1F 
0247   01F3 00 00 00 00 VBAR2     .DB $00,$00,$00,$00,$00,$00,$1F,$1F
0247   01F7 00 00 1F 1F 
0248   01FB 00 00 00 00 VBAR3     .DB $00,$00,$00,$00,$00,$1F,$1F,$1F
0248   01FF 00 1F 1F 1F 
0249   0203 00 00 00 00 VBAR4     .DB $00,$00,$00,$00,$1F,$1F,$1F,$1F
0249   0207 1F 1F 1F 1F 
0250   020B 00 00 00 1F VBAR5     .DB $00,$00,$00,$1F,$1F,$1F,$1F,$1F
0250   020F 1F 1F 1F 1F 
0251   0213 00 00 1F 1F VBAR6     .DB $00,$00,$1F,$1F,$1F,$1F,$1F,$1F
0251   0217 1F 1F 1F 1F 
0252   021B 00 1F 1F 1F VBAR7     .DB $00,$1F,$1F,$1F,$1F,$1F,$1F,$1F
0252   021F 1F 1F 1F 1F 
0253   0223             
0254   0223 00 40 14 54 LINEDAT   .DB $00,$40,$14,$54
0255   0227             
0256   0227             ; the sine list emulates the following formula: 
0257   0227             ; y = sin(I*24)*15 + 16  , where I is in degrees 
0258   0227 10 16 1B 1E sine      .DB 16,22,27,30,31,29,25,19,13,7,3,1,2,5,10 
0258   022B 1F 1D 19 13 
0258   022F 0D 07 03 01 
0258   0233 02 05 0A 
0259   0236             
0260   0236             .ENDtasm: Number of errors = 0
