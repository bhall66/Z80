0983   05AD             
0984   05AD             ; XOR-SHIFT random number generator
0985   05AD             ; returns reg A = 8-bit result
0986   05AD             Random: 
0987   05AD E5              PUSH HL
0988   05AE D5              PUSH DE
0989   05AF 21 80 A2        LD   HL,$A280
0990   05B2 11 DE C0        LD   DE,$C0DE
0991   05B5 7C              LD   a,h         
0992   05B6 87              add  a,a
0993   05B7 AC              xor  h
0994   05B8 65              LD   h,l        
0995   05B9 6A              LD   l,d        
0996   05BA 53              LD   d,e        
0997   05BB 5F              LD   e,a
0998   05BC 1F              rra            
0999   05BD AB              xor  e
1000   05BE 5F              LD   e,a
1001   05BF 7A              LD   a,d        
1002   05C0 87              add  a,a
1003   05C1 87              add  a,a
1004   05C2 87              add  a,a
1005   05C3 AA              xor  d
1006   05C4 AB              xor  e
1007   05C5 5F              LD   e,a
1008   05C6 22 B0 05        LD   (Random+3),HL
1009   05C9 ED 53 B3 05     LD   (Random+6),DE
1010   05CD D1              POP  DE
1011   05CE E1              POP  HL 
1012   05CF C9              RET
1013   05D0             
1014   05D0             
1015   05D0             ; INTEGER DIVISION: A/B
1016   05D0             ;   return A= A mod B
1017   05D0             ;   return C= A div B
1018   05D0             ;
1019   05D0             IntDiv:
1020   05D0 0E 00           LD   C,0
1021   05D2             id1:
1022   05D2 0C              INC  C
1023   05D3 90              SUB  B
1024   05D4 30 FC           JR   NC,id1
1025   05D6 0D              DEC  C 
1026   05D7 80              ADD  A,B
1027   05D8 C9              RET  
