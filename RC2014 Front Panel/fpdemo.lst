1030   05D9             ; Print "<msg> DEMO"
1031   05D9             ; Call with HL = address of 4-character message
1032   05D9             ;
1033   05D9             LabelIt:
1034   05D9 CD 31 05        CALL ClearScreen         ; clear the display
1035   05DC 3E 01           LD   A,1
1036   05DE 06 00           LD   B,0
1037   05E0 CD 4D 05        CALL GotoRC              ; goto row1,col0          
1038   05E3 CD 37 05        CALL SendString          ; print 1st msg
1039   05E6 3E 02           LD   A,2
1040   05E8 06 00           LD   B,0
1041   05EA CD 4D 05        CALL GotoRC              ; goto row2,col0
1042   05ED 21 FA 09        LD   HL,testMsg
1043   05F0 CD 37 05        CALL SendString          ; print 2nd msg
1044   05F3 C9              RET 
1045   05F4             
1046   05F4             ; call with HL pointing to name of the demo
1047   05F4             ;
1048   05F4             LabelDemo:
1049   05F4 CD 31 05        CALL ClearScreen;
1050   05F7 3E 02           LD   A,2
1051   05F9 06 00           LD   B,0
1052   05FB CD 4D 05        CALL GotoRC              ; goto row1,col0          
1053   05FE CD 37 05        CALL SendString          ; print 1st msg
1054   0601 3E 00           LD   A,0
1055   0603 06 00           LD   B,0
1056   0605 CD 4D 05        CALL GotoRC              ; goto row2,col0
1057   0608 21 94 09        LD   HL,msg0
1058   060B CD 37 05        CALL SendString          ; print 2nd msg
1059   060E C9              RET    
1060   060F             
1061   060F             ; Looks for keyboard input
1062   060F             ; Returns zero flag set if no input
1063   060F             ; Returns A=0 to 15 for hex input
1064   060F             ; Closes app on non-hex input
1065   060F             ;
1066   060F             CheckKeypress
1067   060F C5              PUSH BC
1068   0610 D5              PUSH DE 
1069   0611 E5              PUSH HL
1070   0612 0E 80           LD   C,$80               ; for current console.
1071   0614 06 02           LD   B,$02               ; check char input buffer
1072   0616 CF              RST  08                  ; call the HBIOS routine
1073   0617 E1              POP  HL
1074   0618 D1              POP  DE
1075   0619 C1              POP  BC 
1076   061A C8              RET  Z                   ; nothing waiting, so return
1077   061B 0E 80           LD   C,$80               ; for current console.
1078   061D 06 00           LD   B,0                 ; get waiting character
1079   061F CF              RST  08                  ; call the HBIOS routine
1080   0620 7B              LD   A,E                 ; A = received character
1081   0621 CD 36 06        CALL HexToBin            ; try to convert it to binary
1082   0624 FE FF           CP   $FF                 ; was it hex input?
1083   0626 C0              RET  NZ                  ; yes, return with it
1084   0627 AF              XOR  A                   ; no it wasn't; shut down
1085   0628 D3 00           OUT  (0),A               ; turn off the lights!
1086   062A CD 31 05        CALL ClearScreen         ; clear the screen
1087   062D 21 94 09        LD   HL,msg0
1088   0630 CD 37 05        CALL SendString          ; Restore ownership string
1089   0633 C3 00 00        JP   0                   ; & return to CP/M
1090   0636             
1091   0636             
1092   0636             HexToBin:
1093   0636 FE 30           CP   '0'                 ; Compare with '0'
1094   0638 38 1F           JR   C,invalid           ; If less, invalid
1095   063A FE 3A           CP   '9'+1
1096   063C 38 12           JR   C,digit             ; If <= '9', it's a decimal digit
1097   063E FE 41           CP   'A'                 ; Compare with 'A'
1098   0640 38 17           JR   C,invalid           ; If less, invalid
1099   0642 FE 47           CP   'F'+1
1100   0644 38 0D           JR   C,ucAlpha           ; If <= 'F', uppercase alpha
1101   0646 FE 61           CP   'a'                 ; Compare with 'a'
1102   0648 38 0F           JR   C,invalid           ; If less, invalid
1103   064A FE 67           CP   'f'+1
1104   064C 38 08           JR   C,lcAlpha           ; If <= 'f', lowercase alpha
1105   064E 18 09           JR   invalid             ; Anything else is invalid
1106   0650             digit:                       ; convert digits '0'–'9
1107   0650 D6 30           SUB  '0'                 ; Subtract ASCII '0'
1108   0652 C9              RET
1109   0653             ucAlpha:                     ;  convert uppercase 'A'–'F'
1110   0653 D6 37           SUB  'A'-10              ; 'A' → 10
1111   0655 C9              RET 
1112   0656             lcAlpha:                     ;  convert Lowercase 'a'–'f'
1113   0656 D6 57           SUB  'a'-10              ; 'a' → 10
1114   0658 C9              RET
1115   0659             invalid:
1116   0659 3E FF           LD   A, $FF              ; set A to 0xFF for error code
1117   065B C9              RET 
