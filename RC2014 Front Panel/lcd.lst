0001   0000             ;
0002   0000             ;   Title:   LCD.asm
0003   0000             ;  Author:   Bruce E. Hall, w8bh
0004   0000             ;    Date:   27 Aug 2026
0005   0000             ;      HW:   RC2014Zed with 512K RAM/ROM module
0006   0000             ;      SW:   TASM compiler, RomWBW firmware
0007   0000             ;
0008   0000             ;  Get the command tail string
0009   0000             ;  and send it to the front panel
0010   0000             ;
0011   0000             
0012   0000             cmdPort	      .equ	  $DA	 ; port for HD44780 command register
0013   0000             dataPort	  .equ	  $DB	 ; port for HD44780 data register 
0014   0000             
0015   0000             ; HD44780 Controller Commands 
0016   0000             ;
0017   0000             CLEAR_SCREEN  .equ    $01    ; clear screen command
0018   0000             CURSOR_HOME   .equ    $02    ; home the cursor
0019   0000             DISPLAY_OFF   .equ    $08    ; turn display off
0020   0000             DISPLAY_ON    .equ    $0C    ; display on with no cursor
0021   0000             CURSOR_ON     .equ    $0E    ; display on with underline cursor
0022   0000             CURSOR_BLINK  .equ    $0F    ; display on with blinking block cursor
0023   0000             CURSOR_LEFT   .equ    $10    ; move cursor left
0024   0000             CURSOR_RIGHT  .equ    $14    ; move cursor right
0025   0000             DISP_INIT4    .equ    $28    ; initialize display for 4-bit input
0026   0000             DISP_INIT8    .equ    $38    ; initialize display for 8-bit input
0027   0000             LOAD_SYMBOL   .equ    $40    ; set CG-RAM address
0028   0000             SET_CURSOR    .equ    $80    ; set display RAM address
0029   0000             
0030   0000             
0031   0100             .ORG $0100
0032   0100             
0033   0100             Start:   
0034   0100 CD 21 01        CALL ClearScreen
0035   0103 21 80 00        LD HL,$0080              ; point to command tail
0036   0106 46              LD B,(HL)                ; get tail length
0037   0107 23              INC HL                   ; ignore 1st char (space)
0038   0108 05              DEC B 
0039   0109             j0:
0040   0109 23              INC HL                   ; point to next char
0041   010A 7E              LD A,(HL)                ; get it
0042   010B CD 19 01        CALL SendChar            ; & show it on LCD
0043   010E 10 F9           DJNZ j0                  ; loop for all chars
0044   0110 C9              RET
0045   0111             
0046   0111             
0047   0111             ;=============================================================
0048   0111             ;
0049   0111             ;   LCD ROUTINES
0050   0111             ;
0051   0111             
0052   0111             SendCommand:
0053   0111 D3 DA           OUT (cmdPort),A          ; send the command
0054   0113 DB DA           IN A,(cmdPort)           ; check LCD status (bit 7 = busy)
0055   0115 07              RLCA                     ; move status bit to carry 
0056   0116 38 FB           JR  C,$-3                ; wait until ready
0057   0118 C9              RET
0058   0119             
0059   0119             SendChar:
0060   0119 D3 DB           OUT (dataPort),A         ; send a character to LCD
0061   011B DB DA           IN A,(cmdPort)           ; check LCD status (bit 7 = busy)
0062   011D 07              RLCA                     ; move status bit to carry 
0063   011E 38 FB           JR  C,$-3                ; wait until ready
0064   0120 C9              RET
0065   0121             
0066   0121             ClearScreen:
0067   0121 3E 01           LD   A,CLEAR_SCREEN
0068   0123 CD 11 01        CALL SendCommand
0069   0126 C9              RET 
0070   0127             
0071   0127             SendString:
0072   0127 7E          	LD	A,(HL)			     ; next character to send
0073   0128 B7          	OR	A			         ; set flags
0074   0129 C8          	RET	Z			         ; done on null
0075   012A CD 19 01    	CALL SendChar            ; send the character
0076   012D 23          	INC	HL			         ; point to next char
0077   012E 18 F7       	JR	SendString    	     ; and loop until done
0078   0130             
0079   0130             .END
0080   0130             
